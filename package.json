{
  "name": "api-sentinel",
  "version": "1.0.0",
  "description": "API Sentinel is an automated API security testing platform designed to identify common REST API security weaknesses through controlled tests, analyze observed behavior, and generate evidence-backed reports.",
  "main": "index.js",
  "scripts": {
    "test": "jest --runInBand",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "scan": "node scanner/src/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spandanse/api-sentinel.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/spandanse/api-sentinel/issues"
  },
  "homepage": "https://github.com/spandanse/api-sentinel#readme",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
